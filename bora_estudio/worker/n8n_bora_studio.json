    "jsCode": "// Traduz o aviso do Supabase em pedido pro editor\nconst b = $input.first().json.body || $input.first().json;\nconst r = b.record || {}, o = b.old_record || {};\nlet p = null;\nif (b.table === 'versoes' && b.type === 'INSERT' && r.status === 'editando')\n  p = { tipo: r.numero > 1 ? 'ajuste' : 'nova_edicao', projeto_id: r.projeto_id, versao_id: r.id, versao: r.numero };\nif (b.table === 'projetos' && b.type === 'UPDATE' && r.status === 'aprovado' && o.status !== 'aprovado')\n  p = { tipo: 'final', projeto_id: r.id, cliente: r.cliente_id };\nreturn p ? [{ json: p }] : [];"
   },
